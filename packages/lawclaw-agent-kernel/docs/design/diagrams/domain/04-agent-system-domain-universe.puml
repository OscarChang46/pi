@startuml AgentSystemDomainUniverse
!include drawio-theme.puml
title Agent Kernel System 领域对象全集
left to right direction
hide methods
hide fields

class "业务编排" as Orchestration <<external_subdomain>>
class "KernelHost" as KernelHost <<external_subdomain>>
class "Agent Adapter" as Adapter <<external_subdomain>>
class "Infrastructure" as Infrastructure <<infrastructure>>
interface AgentSystemGateway <<inbound_port>>

package "Agent Kernel System" as Kernel <<bounded_context>> {
  package "Agent Registry" as Registry <<domain_module>> {
    class AgentDefinition <<aggregate_root>>
    class AgentDefinitionVersion <<entity>>
    class AgentDescriptor <<value_object>>
    class CapabilityDescriptor <<value_object>>
    class AgentRoleDescriptor <<value_object>>
    AgentDefinition *-- AgentDefinitionVersion
    AgentDefinitionVersion *-- AgentDescriptor
    AgentDescriptor *-- CapabilityDescriptor
    AgentDefinitionVersion *-- AgentRoleDescriptor
  }

  package "Run Domain" as RunDomain <<domain_module>> {
    class AgentRun <<aggregate_root>>
    class AgentRunAttempt <<entity>>
    class AgentLoopStep <<entity>>
    class AgentEvent <<entity>>
    class RunTrigger <<value_object>>
    class RouteSnapshot <<value_object>>
    class RuntimeLease <<value_object>>
    class RunBudget <<value_object>>
    class AgentCheckpoint <<entity>>
    AgentRun *-- AgentRunAttempt
    AgentRunAttempt *-- AgentLoopStep
    AgentRun *-- AgentEvent
    AgentRun *-- RunTrigger
    AgentRun *-- RouteSnapshot
    AgentRun o-- RuntimeLease
    AgentRun *-- RunBudget
    AgentRunAttempt o-- AgentCheckpoint
  }

  package "Structured Subagent" as Collaboration <<domain_module>> {
    class AgentExecutionScope <<aggregate_root>>
    class DelegationPolicy <<value_object>>
    class DelegationSpec <<value_object>>
    class ParentChildRunLink <<entity>>
    AgentExecutionScope *-- ParentChildRunLink
    AgentExecutionScope *-- DelegationPolicy
    ParentChildRunLink *-- DelegationSpec
  }

  package "Context" as ContextModule <<domain_module>> {
    class AgentSession <<aggregate_root>>
    class ContextDelta <<entity>>
    class ContextSpec <<value_object>>
    class ContextItem <<value_object>>
    class ContextFrame <<value_object>>
    class ContextSnapshot <<entity>>
    class ContextReductionTrace <<value_object>>
    AgentSession *-- ContextDelta
    AgentSession *-- ContextSnapshot
    ContextSnapshot *-- ContextItem
    ContextSnapshot *-- ContextFrame
    ContextSnapshot *-- ContextReductionTrace
  }

  package "Memory" as MemoryModule <<domain_module>> {
    class MemorySpace <<aggregate_root>>
    class MemoryEntry <<entity>>
    class MemoryVersion <<value_object>>
    class MemoryView <<value_object>>
    class MemoryGrant <<value_object>>
    class MemoryCandidate <<entity>>
    MemorySpace *-- MemoryEntry
    MemorySpace *-- MemoryVersion
    MemorySpace o-- MemoryGrant
  }

  package "Permission" as PermissionModule <<domain_module>> {
    class AgentExecutionEnvelope <<value_object>>
    class AgentExecutionIdentity <<value_object>>
    class ExecutionAuthoritySnapshot <<value_object>>
    class ResourceBindingSet <<value_object>>
    class ActionProposal <<value_object>>
    class PermissionDecision <<value_object>>
    class PermissionRequest <<aggregate_root>>
    class ApprovalDecision <<value_object>>
    class ExecutionPermit <<aggregate_root>>
    AgentExecutionEnvelope *-- AgentExecutionIdentity
    AgentExecutionEnvelope *-- ExecutionAuthoritySnapshot
    AgentExecutionEnvelope *-- ResourceBindingSet
    PermissionRequest *-- ActionProposal
    PermissionRequest o-- ApprovalDecision
    ExecutionPermit *-- ActionProposal
  }

  package "Tool" as ToolModule <<domain_module>> {
    class ToolDefinition <<aggregate_root>>
    class ToolDescriptor <<value_object>>
    class ToolCall <<aggregate_root>>
    class ToolCallCandidate <<value_object>>
    class AuthorizedToolRequest <<value_object>>
    class ToolResult <<value_object>>
    class SandboxProfile <<value_object>>
    class SandboxRequest <<value_object>>
    ToolDefinition *-- ToolDescriptor
    ToolCall *-- ToolCallCandidate
    ToolCall o-- AuthorizedToolRequest
    ToolCall o-- ToolResult
    SandboxRequest --> SandboxProfile
  }

  package "Shared Technical Values" as Shared <<domain_module>> {
    class ArtifactReference <<value_object>>
    class OperationContext <<value_object>> {
      +traceId: TraceId
      +correlationId: CorrelationId
      +deadline: TimePoint
      +timeContext: TimeContext
    }
    class TimeContext <<value_object>> {
      +timeZone: IanaTimeZone
      +locale: Locale
    }
    class TimePoint <<value_object>> {
      +epochMillis: long
      +isoUtc: string
    }
    class CommandReceipt <<value_object>> {
      +commandId: CommandId
      +payloadHash: Hash
      +resultRef: ResultRef
    }
    class AgentExecutionEnvelopeRef <<reference>>
    OperationContext *-- TimeContext
    OperationContext *-- TimePoint
  }

  class AgentControlPlane <<application_service>>
  class AgentRuntime <<domain_service>>
  class RunScheduler <<domain_service>>
  class RunRegistry <<domain_service>>
  class ContextEngine <<domain_service>>
  class MemoryManager <<application_service>>
  class PermissionSystem <<domain_service>>
  class ToolRuntime <<application_service>>
  class SubagentCoordinator <<application_service>>
  class FlowEngine <<domain_service>>
  class ResourceManager <<application_service>>

  interface AgentRegistryQueryPort <<inbound_port>>
  interface RunCommandPort <<inbound_port>>
  interface RuntimeEventPort <<inbound_port>>
  interface RuntimeControlPort <<inbound_port>>
  interface ContextPort <<inbound_port>>
  interface MemoryPort <<inbound_port>>
  interface PermissionDecisionPort <<inbound_port>>
  interface PermitValidationPort <<inbound_port>>
  interface ToolRuntimePort <<inbound_port>>
  interface ChildRunPort <<inbound_port>>
  interface AgentAdapterPort <<outbound_port>>
  interface RunRepositoryPort <<outbound_port>>
  interface ArtifactPort <<outbound_port>>
  interface SandboxPort <<outbound_port>>
  interface SecretResolverPort <<outbound_port>>
  interface ClockPort <<outbound_port>>

  AgentSystemGateway --> AgentControlPlane : command / query
  AgentControlPlane --> RunCommandPort : 创建执行意图
  RunScheduler --> AgentRegistryQueryPort : 解析能力与路由候选
  AgentRuntime --> ContextPort : 组装上下文
  AgentRuntime --> RuntimeEventPort : 发布 ToolCallCandidate
  AgentControlPlane --> ToolRuntimePort : L1 授权后调用工具
  AgentControlPlane --> RuntimeControlPort : 回送 ToolResultRef
  RuntimeControlPort --> AgentRuntime : resumeAttempt
  AgentRuntime --> ChildRunPort : 委派 Child Run
  ContextEngine --> MemoryPort : 读取授权记忆视图
  ToolRuntime --> PermissionDecisionPort : 工具动作决策
  ToolRuntime --> PermitValidationPort : 执行前消费
  MemoryManager --> PermissionDecisionPort : 记忆访问决策
  MemoryManager --> PermitValidationPort : 提交前消费
  SubagentCoordinator --> PermissionDecisionPort : Child Run 委派决策
  SubagentCoordinator --> PermitValidationPort : 创建前消费
  AgentRuntime --> AgentAdapterPort : executeTurn
  RunRegistry --> RunRepositoryPort : 权威 Run 状态
  ToolRuntime --> SandboxPort
  ToolRuntime --> SecretResolverPort
  ToolRuntime --> ArtifactPort
  AgentRuntime --> ClockPort
}

show OperationContext fields
show TimeContext fields
show TimePoint fields
show CommandReceipt fields

Orchestration --> AgentSystemGateway : submitRun / queryRun
KernelHost --> AgentSystemGateway : 可信 AgentExecutionEnvelopeRef
AgentAdapterPort --> Adapter : 屏蔽 Runtime 差异
RunRepositoryPort --> Infrastructure : 持久化机制
ArtifactPort --> Infrastructure : Artifact 机制
SandboxPort --> Infrastructure : 沙箱机制
SecretResolverPort --> Infrastructure : Secret 机制
ClockPort --> Infrastructure : 时钟机制

note bottom of Kernel
  Agent Kernel System 是唯一限界上下文；内部仅为领域模块。
  模块间行为调用必须经过 Port，跨模块数据只传递 ID、Ref 或快照。
end note
@enduml
