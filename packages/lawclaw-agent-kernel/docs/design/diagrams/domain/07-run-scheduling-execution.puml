@startuml RunSchedulingExecution
!include drawio-theme.puml
title Run、调度与执行模块
left to right direction

class "AgentSystemGateway" as Gateway <<external_subdomain>>
class "SubagentCoordinator" as Subagent <<external_subdomain>>
class "AgentRuntime" as Runtime <<external_subdomain>>
class "Persistence" as Persistence <<infrastructure>>
class "Observability / Event Bus" as EventBus <<external_subdomain>>

package "Agent Kernel System" as Kernel <<bounded_context>> {
  package "Run Domain" as RunModule <<domain_module>> {
    interface RunCommandPort <<inbound_port>> {
      +submit(trigger, routeProposal, budget, envelopeRef): RunId
      +cancel(runId, reason, envelopeRef)
    }
    interface RunQueryPort <<inbound_port>> {
      +get(runId, envelopeRef): RunSnapshot
      +readEvents(runId, afterSequence, envelopeRef)
    }
    interface ChildRunPort <<inbound_port>> {
      +submitChild(parentRunId, delegationSpec, envelopeRef): RunId
      +join(scopeId, envelopeRef)
    }
    interface RuntimeDispatchPort <<outbound_port>> {
      +dispatch(runId, lease, envelopeRef)
      +interrupt(runId, reason)
    }
    interface RunExecutionPort <<inbound_port>> {
      +startAttempt(runId, leaseId): AttemptId
      +appendStep(attemptId, step)
      +completeAttempt(attemptId, outcome)
    }
    interface RunRepositoryPort <<outbound_port>> {
      +load(runId)
      +save(run, expectedVersion)
    }
    interface CommandReceiptRepositoryPort <<outbound_port>> {
      +find(commandId)
      +save(receipt)
    }
    interface AgentEventPublisherPort <<outbound_port>> {
      +publish(committedEvents)
    }
    class RunApplicationService <<application_service>>
    class RunScheduler <<domain_service>>
    class RunRegistry <<domain_service>>
    class AgentRun <<aggregate_root>> {
      +runId: RunId
      +status: RunStatus
      +definitionVersionRef: DefinitionVersionRef
      +executionScopeId: ExecutionScopeId
      +executionEnvelopeRef: AgentExecutionEnvelopeRef
      +nextSequence: long
    }
    class AgentRunAttempt <<entity>> {
      +attemptId: AttemptId
      +runtimeLeaseId: RuntimeLeaseId?
      +status: AttemptStatus
    }
    class AgentLoopStep <<entity>> {
      +ordinal: integer
      +kind: MODEL|TOOL|MEMORY|DELEGATION
      +status: StepStatus
    }
    class AgentEvent <<entity>> {
      +eventId: EventId
      +sequence: long
      +eventType: AgentEventType
    }
    class RunTrigger <<value_object>> {
      +kind: USER|WORKFLOW|SCHEDULE|SYSTEM|DELEGATION|RECOVERY
      +sourceRef: string
    }
    class RouteSnapshot <<value_object>> {
      +definitionVersionRef: DefinitionVersionRef
      +capabilityDigest: Hash
      +adapterId: AdapterId
      +modelProfileRef: ModelProfileRef
      +toolSetDigest: Hash
    }
    class RuntimeLease <<value_object>> {
      +leaseId: RuntimeLeaseId
      +runtimeId: RuntimeId
      +expiresAt: Instant
      +fenceToken: long
    }
    class RunBudget <<value_object>> {
      +deadlineAt: Instant
      +maxTurns: integer
      +maxTokens: long
      +maxToolCalls: integer
    }
    class AgentCheckpoint <<entity>> {
      +checkpointId: CheckpointId
      +replaySafety: ReplaySafety
    }
    class CommandReceipt <<reference>>
    class AgentExecutionEnvelopeRef <<reference>>
    class RouteProposal <<reference>>

    RunCommandPort <|.. RunApplicationService
    ChildRunPort <|.. RunApplicationService
    RunExecutionPort <|.. RunApplicationService
    RunQueryPort <|.. RunRegistry
    RunApplicationService --> AgentRun
    RunApplicationService --> RunRegistry : register / update index
    RunApplicationService --> RunRepositoryPort
    RunApplicationService --> CommandReceiptRepositoryPort
    RunApplicationService --> AgentEventPublisherPort
    RunApplicationService --> RunScheduler
    RunScheduler --> RunRegistry : issueLease / verifyFence
    RunScheduler --> RuntimeLease : 多 Worker 档案才签发 Lease
    RunScheduler --> RuntimeDispatchPort
    AgentRun *-- AgentRunAttempt
    AgentRunAttempt *-- AgentLoopStep
    AgentRun *-- AgentEvent
    AgentRun *-- RunTrigger
    AgentRun *-- RouteSnapshot
    AgentRun *-- RunBudget
    AgentRun o-- RuntimeLease
    AgentRunAttempt o-- AgentCheckpoint
    AgentRun --> AgentExecutionEnvelopeRef : 冻结可信引用
    RunApplicationService --> RouteProposal : 校验后冻结
    RunApplicationService --> CommandReceipt : 入口幂等，不属于 Run 聚合
  }
}

Gateway --> RunCommandPort : submit / cancel
Gateway --> RunQueryPort : query / events
Subagent --> ChildRunPort : submitChild / join
RuntimeDispatchPort --> Runtime : dispatch(run, lease, envelopeRef)
Runtime --> RunExecutionPort : attempt / step / outcome
RunRepositoryPort --> Persistence : CAS persistence
CommandReceiptRepositoryPort --> Persistence : command idempotency
AgentEventPublisherPort ..> EventBus : committed AgentEvent

note bottom of Runtime
  Runtime 仅执行已派发 Attempt，不得直接修改调度队列。
  AgentExecutionEnvelopeRef 从 Run 冻结值随 Dispatch 传播。
  首版本地单 Worker 以 attemptId + aggregateVersion 拒绝旧回调；RuntimeLease 可选。
end note
@enduml
