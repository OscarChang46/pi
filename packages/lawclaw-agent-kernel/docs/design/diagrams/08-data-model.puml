@startuml 08-data-model
!include theme.puml
title Agent Kernel 首版领域模型：Context、Tool 与父子 Run

hide methods
hide circle
skinparam classAttributeIconSize 0

package "请求上下文值对象" as REQUEST_CONTEXT LC_EXTERNAL {
  class TenantContext <<值对象>> {
    tenant_id: TenantId
  }
  class OperationContext <<值对象>> {
    trace_id: TraceId
    deadline_at: Instant
  }
  class TimeContext <<值对象>> {
    time_zone: IANA ZoneId
    locale: BCP47 LanguageTag
  }
  class TimePoint <<值对象>> {
    epoch_milliseconds: integer
    iso_utc: Instant
  }
  class RequestContext <<值对象>>
}

package "Agent Kernel 首版核心" as DOMAIN LC_KERNEL {
  class AgentRun <<聚合根>> {
    run_id: AgentRunId
    tenant_id: TenantId
    parent_run_id: AgentRunId?
    delegation_id: DelegationId?
    retry_of_run_id: AgentRunId?
    status: AgentRunStatus
    route_snapshot: RouteSnapshot
    next_sequence: integer
  }
  class AgentSession <<聚合根>> {
    session_id: AgentSessionId
    agent_id: AgentId
  }
  class AgentEvent <<不可变实体>> {
    event_id: AgentEventId
    sequence: integer
    event_type: AgentEventType
  }
  class ContextSpec <<值对象>> {
    source_refs: list
    policy_ref: string
  }
  class ContextItem <<值对象>> {
    kind: ContextItemKind
    content_ref: ArtifactRef
    priority: integer
  }
  class ContextFrame <<值对象>> {
    frame_id: ContextFrameId
    estimated_tokens: integer
  }
  class ContextSnapshot <<实体>> {
    snapshot_id: ContextSnapshotId
    turn_ordinal: integer
  }
  class ContextReductionTrace <<值对象>> {
    action: keep|drop|summarize
    reason_code: string
  }
  class ToolDescriptor <<值对象>> {
    name: string
    version: string
    read_only: boolean
    risk: ToolRisk
  }
  class ToolCallState <<实体>> {
    tool_call_id: ToolCallId
    status: ToolCallStatus
    side_effect_state: SideEffectState
  }
  class DelegationPolicy <<值对象>> {
    max_depth: integer=1
    max_children: integer
    max_concurrency: integer
  }
  class DelegationSpec <<值对象>> {
    objective_ref: ArtifactRef
    context_mode: fresh|selected
    result_schema_ref: ArtifactRef?
  }
  class TechnicalApprovalRequest <<实体>> {
    request_id: TechnicalApprovalRequestId
    status: TechnicalDecisionStatus
  }
  class AgentDescriptor <<实体>> {
    agent_id: AgentId
    adapter_id: AgentAdapterId
    contract_version: string
  }
  class CapabilityDescriptor <<值对象>> {
    execution_profile: embedded|managed
    context: boolean
    tools: boolean
    delegation: boolean
  }
  class CommandReceipt <<幂等记录>> {
    command_id: CommandId
    payload_hash: string
  }
  class ArtifactReference <<值对象>> {
    artifact_id: ArtifactId
    content_hash: string
  }
}

package "后续可选恢复档案" as FUTURE LC_INFRASTRUCTURE {
  class AgentRunAttempt <<可选实体>> {
    attempt_id: AgentRunAttemptId
    fence_token: integer
  }
  class AgentCheckpoint <<可选实体>> {
    checkpoint_id: AgentCheckpointId
    replay_safety: ReplaySafety
  }
}

RequestContext *-- TenantContext
RequestContext *-- OperationContext
RequestContext *-- TimeContext
OperationContext --> TimePoint : deadline / request_started
AgentEvent --> TimePoint : occurred_at
AgentSession "1" o-- "0..*" AgentRun
AgentRun "0..1 父" --> "0..* 子" AgentRun : 技术委派
AgentRun "0..1 旧 Run" ..> "0..* 新 Run" AgentRun : 显式重试谱系
AgentRun "1" *-- "1..*" AgentEvent
AgentRun "1" *-- "0..*" ContextSnapshot
ContextSnapshot "1" *-- "1..*" ContextItem
ContextSnapshot "1" --> "1" ContextFrame
ContextSnapshot "1" *-- "0..*" ContextReductionTrace
AgentRun "1" *-- "0..*" ToolCallState
ToolCallState "1" --> "1" ToolDescriptor
ToolCallState "1" o-- "0..1" TechnicalApprovalRequest
AgentRun "0..*" --> "1" DelegationPolicy
AgentRun "0..*" --> "0..1" DelegationSpec
AgentDescriptor "1" *-- "1" CapabilityDescriptor
ContextItem "0..*" --> "1" ArtifactReference
AgentEvent "0..*" --> "0..1" ArtifactReference
CommandReceipt "0..*" --> "0..1" AgentRun
AgentRunAttempt ..> AgentRun : 后续可选
AgentCheckpoint ..> AgentRun : 后续可选

note right of AgentRun
  parent_run_id 只表达技术委派，不是 WorkflowStep。
  不包含业务会话、业务审批或业务结果采纳规则。
  约束：UP-AGT-001、UP-AGT-008、UP-DAT-001、UP-CTX-001、UP-INF-002
end note
@enduml
