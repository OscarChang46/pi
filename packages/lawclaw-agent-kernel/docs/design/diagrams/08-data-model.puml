@startuml
!include theme.puml
title Agent Kernel System 核心对象与生命周期（V3）
left to right direction

package "Run Domain" LC_KERNEL {
  class AgentRun <<aggregate root>>
  class AgentRunAttempt <<entity>>
  class AgentLoopStep <<entity>>
  class AgentEvent <<entity>>
  class RuntimeLease <<value object>>
  class AgentCheckpoint <<entity>>
  AgentRun *-- "1..*" AgentRunAttempt
  AgentRunAttempt *-- "0..*" AgentLoopStep
  AgentRun *-- "0..*" AgentEvent
  AgentRunAttempt o-- "0..1" RuntimeLease
  AgentRunAttempt o-- "0..*" AgentCheckpoint
}

package "Execution Services" LC_KERNEL {
  class RunScheduler <<domain service>>
  class AgentRuntimePool <<application service>>
  class AgentRuntime <<domain service>>
  RunScheduler --> AgentRuntimePool : RuntimeDispatchPort
  AgentRuntimePool o-- "0..*" AgentRuntime : 管理长期 Worker
}

package "Session / Context / Memory" LC_KERNEL {
  class AgentSession <<aggregate root>>
  class ContextFrame <<value object>>
  class MemorySpace <<aggregate root>>
  AgentSession --> "0..*" AgentRun : 关联 Run，不拥有执行状态
  AgentRuntime --> ContextFrame : 每 Step 读取投影
  ContextFrame ..> MemorySpace : 只读 MemoryView
}

package "Permission / Tool / Structured Subagent" LC_KERNEL {
  class ToolCall <<aggregate root>>
  class PermissionRequest <<aggregate root>>
  class ExecutionPermit <<aggregate root>>
  class AgentExecutionScope <<aggregate root>>
  class ParentChildRunLink <<entity>>
  class AgentExecutionEnvelopeRef <<reference>>
  ToolCall --> PermissionRequest : Ask 时关联
  ToolCall --> ExecutionPermit : 执行时绑定
  AgentExecutionScope *-- ParentChildRunLink
  ParentChildRunLink --> AgentRun : parent / child 引用
}

RunScheduler --> AgentRun : 排队 / Lease / 恢复
AgentRuntime --> AgentRunAttempt : 只执行已派发 Attempt
AgentRun --> AgentExecutionEnvelopeRef : 冻结不透明执行约束
ToolCall --> AgentRun : runId 关联，不进入 Run 聚合
AgentExecutionScope --> AgentRun : parent / child 引用

note bottom of AgentRuntime
  Runtime 生命周期长于单个 Run，可连续执行多个 Attempt；
  Runtime 不是聚合根，不拥有 AgentRun 或 AgentSession。
  Session 不对应进程；Multi-agent 团队模型位于上层业务编排。
end note
@enduml
