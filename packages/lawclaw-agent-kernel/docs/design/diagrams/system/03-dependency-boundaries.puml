@startuml
!include ../theme.puml
title 依赖边界与 Composition Root（V3）
top to bottom direction

rectangle "业务编排 / Backend\n外部调用方" as CALLER LC_EXTERNAL
package "Agent Kernel System" as KERNEL LC_KERNEL {
  component "Inbound Ports" as INBOUND
  component "Application Services" as APP
  component "Domain Model" as DOMAIN
  component "Outbound Ports" as OUTBOUND
  INBOUND --> APP
  APP --> DOMAIN
  APP --> OUTBOUND
}
rectangle "Composition Root / KernelHost\n唯一具体 Adapter 装配点" as ROOT LC_EXTERNAL
rectangle "Agent / Tool Adapters" as ADAPTER LC_ADAPTER
rectangle "Storage / Sandbox / Secret / Clock" as INFRA LC_INFRASTRUCTURE

CALLER --> INBOUND : AgentSystemGateway / RunCommandPort
ROOT --> KERNEL : 注入 Port 实现
ROOT --> ADAPTER : 实例化
ROOT --> INFRA : 实例化
OUTBOUND --> ADAPTER : AgentAdapterPort / ToolProviderPort
OUTBOUND --> INFRA : Infrastructure Ports

DOMAIN -[#DC2626,dashed,bold]-> ADAPTER : <color:#B91C1C>禁止依赖具体 Adapter</color>
DOMAIN -[#DC2626,dashed,bold]-> INFRA : <color:#B91C1C>禁止依赖具体机制</color>
CALLER -[#DC2626,dashed,bold]-> DOMAIN : <color:#B91C1C>禁止直接操作领域对象</color>
@enduml
