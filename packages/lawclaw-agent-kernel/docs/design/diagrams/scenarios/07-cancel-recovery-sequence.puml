@startuml
!include ../theme.puml
title 取消、Worker 故障与结构化恢复（V3）

actor "外部调用方" as Caller
participant "AgentSystemGateway" as Gateway
participant "RunRegistry" as Runs
participant "RunScheduler" as Scheduler
participant "SubagentCoordinator" as Subagent
participant "AgentRuntimePool" as Pool
participant "AgentRuntime" as Runtime
participant "CheckpointPort" as Checkpoint

Caller -> Gateway : cancel(runId, reason, envelopeRef)
Gateway -> Runs : RunCommandPort.cancel(runId, reason)
Runs -> Scheduler : revokeLease(runId)
Scheduler -> Subagent : cancelChildren(scopeId)
Subagent --> Scheduler : children terminal / transferred
Scheduler -> Pool : interrupt(runId, fenceToken)
Pool -> Runtime : abort current step
Runtime --> Runs : canceled(attemptId)
Runs --> Gateway : AgentRunCanceled
Gateway --> Caller : canceled

== Worker 崩溃 ==
Pool -> Scheduler : runtimeLost(runtimeId)
Scheduler -> Runs : markAttemptInterrupted(leaseId)
Runs -> Checkpoint : inspectSafeCheckpoint(runId)
alt 可安全恢复且无未知副作用
  Checkpoint --> Runs : checkpointRef
  Runs -> Scheduler : enqueueRecovery(runId, checkpointRef)
  Scheduler -> Pool : dispatch new Attempt + new Lease
else 不满足安全条件
  Checkpoint --> Runs : unsafe(reason)
  Runs --> Gateway : AgentRunFailed(recoveryUnsafe)
end
@enduml
