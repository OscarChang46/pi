@startuml
!include theme.puml
title Agent Kernel System 内部组件（V3）
left to right direction

package "Agent Kernel System" as KERNEL LC_KERNEL {
  component "AgentSystemGateway\n应用门面" as GATEWAY
  component "AgentControlPlane\n命令协调" as CONTROL
  component "AgentRegistry\n定义 / 能力 / 路由" as REGISTRY
  component "RunRegistry\nRun 权威状态" as RUN
  component "RunScheduler\n队列 / Lease / 调度" as SCHEDULER
  component "FlowEngine\n无状态流程推进" as FLOW
  component "ResourceManager\n执行槽 / 资源预算" as RESOURCE
  component "AgentSessionService\n上下文档案 / 版本锁" as SESSION
  component "AgentRuntimePool\n长期 Worker 管理" as POOL
  component "AgentRuntime\nAgent Loop 执行服务" as RUNTIME
  component "ContextEngine\n上下文投影" as CONTEXT
  component "MemoryManager\n长期记忆" as MEMORY
  component "PermissionSystem\nAllow / Ask / Deny" as PERMISSION
  component "ToolRuntime\n工具安全管线" as TOOL
  component "SubagentCoordinator\nChild Run / Join / Cancel" as SUBAGENT

  GATEWAY --> CONTROL : AgentSystemGateway
  CONTROL --> REGISTRY : AgentRegistryQueryPort
  CONTROL --> RUN : RunCommandPort
  CONTROL --> SESSION : SessionPort
  RUN --> SCHEDULER : RunSchedulingPort
  SCHEDULER --> RESOURCE : ExecutionResourcePort
  RESOURCE --> POOL : RuntimeDispatchPort
  POOL --> RUNTIME : 派发 Attempt + Lease
  RUNTIME --> FLOW : advance(RunSnapshot, SessionSnapshot)
  RUNTIME --> CONTEXT : ContextPort
  RUNTIME --> TOOL : ToolRuntimePort
  RUNTIME --> SUBAGENT : ChildRunPort
  CONTEXT --> MEMORY : MemoryQueryPort
  TOOL --> PERMISSION : PermissionDecisionPort\nPermitValidationPort
  SUBAGENT --> PERMISSION : PermissionDecisionPort\nPermitValidationPort
  SUBAGENT --> SCHEDULER : RunSchedulerPort
  MEMORY --> PERMISSION : PermissionDecisionPort\nPermitValidationPort
}

note bottom of RUNTIME
  Runtime 不拥有 Run、会话、权限或调度队列；
  它只执行已由 Scheduler 派发且带有效 Lease 的 Attempt。
  Session 不对应进程；FlowEngine 不保存权威状态。
end note
@enduml
