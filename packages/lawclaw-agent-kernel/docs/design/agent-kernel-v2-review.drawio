        <mxCell id="p1-e-runtime-adapter" value="AgentAdapter Port" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#00897B;endArrow=block;endFill=1;fontFamily=PingFang SC;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.1;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1-runtime" target="p1-adapter"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="300" /><mxPoint x="1345" y="300" /><mxPoint x="1345" y="135" /></Array></mxGeometry></mxCell>
