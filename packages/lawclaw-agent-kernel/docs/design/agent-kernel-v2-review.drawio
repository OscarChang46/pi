        <UserObject label="PolicySnapshotPort" plantUmlId="cap_10" plantUmlBaseStyle="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=14;whiteSpace=wrap;" plantUmlBaseValue="PolicySnapshotPort" id="RLRcLOaS1M9PtmScGumW-12">
          <mxCell parent="RLRcLOaS1M9PtmScGumW-2" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=14;whiteSpace=wrap;" vertex="1">
