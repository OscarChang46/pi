        <UserObject label="L3/L4: 受控与沙盒执行层 (Execution Runtime)" plantUmlId="ct_47" plantUmlBaseStyle="rounded=0;fillColor=#E9F7EF;strokeColor=#000000;strokeWidth=1.5;fontStyle=0;fontSize=14;align=left;spacingLeft=6;verticalAlign=middle;" plantUmlBaseValue="L3/L4: 受控与沙盒执行层 (Execution Runtime)" id="shljIDy1qJwBftTrzA7N-61">
          <mxCell parent="shljIDy1qJwBftTrzA7N-89" style="rounded=0;fillColor=#E9F7EF;strokeColor=#000000;strokeWidth=1.5;fontStyle=0;fontSize=14;align=left;spacingLeft=6;verticalAlign=middle;" vertex="1">
