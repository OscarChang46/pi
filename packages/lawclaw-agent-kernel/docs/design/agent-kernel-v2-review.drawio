<mxfile host="Electron" agent="Codex" compressed="false" pages="5">
  <diagram id="kernel-v2-components" name="01 组件边界">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1-title" value="&lt;b&gt;Agent Kernel System V3 候选架构｜系统职责、控制面与执行面&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;系统管理多个 Agent、AgentRun 与 Runtime Worker；用户单轮只是 Root AgentRun 的一种触发来源&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=20;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1510" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p1-host" value="&lt;b&gt;AgentGateway Facade / KernelHost&lt;/b&gt;&lt;br&gt;认证、RBAC、租户解析&lt;br&gt;隔离分区与 Scoped Adapter 绑定&lt;br&gt;业务编排结果采纳&lt;br&gt;&lt;font color=&quot;#C62828&quot;&gt;全部位于纯 Kernel 外部&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;strokeColor=#EF6C00;fillColor=#FFF3E0;fontFamily=PingFang SC;fontSize=13;fontColor=#172033;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="175" width="245" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p1-kernel" value="&lt;b&gt;Agent Kernel System 边界&lt;/b&gt;　Agent 控制面｜运行调度｜执行面｜权限｜工具｜记忆｜多 Agent" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=3;strokeColor=#8D6E63;fillColor=#FFFDFC;verticalAlign=top;align=left;spacingTop=10;spacingLeft=14;fontFamily=PingFang SC;fontSize=17;fontColor=#5D4037;" vertex="1" parent="1">
          <mxGeometry x="305" y="80" width="1040" height="735" as="geometry" />
        </mxCell>
        <mxCell id="p1-gateway" value="&lt;b&gt;AgentSystemGateway&lt;/b&gt;&lt;br&gt;submitRun / submitTeam&lt;br&gt;get / cancel / events" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;strokeColor=#D97706;fillColor=#FCE8D5;fontFamily=PingFang SC;fontSize=13;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="345" y="125" width="225" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p1-control" value="&lt;b&gt;Agent Control Plane&lt;/b&gt;&lt;br&gt;Agent Registry / Run Registry&lt;br&gt;Run Scheduler / Queue / Lease&lt;br&gt;ExecutionScope / 技术路由" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=3;strokeColor=#C65D1E;fillColor=#FCE8D5;fontFamily=PingFang SC;fontSize=13;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="690" y="115" width="280" height="155" as="geometry" />
        </mxCell>
        <mxCell id="p1-adapter" value="&lt;b&gt;AgentAdapter Port&lt;/b&gt;&lt;br&gt;executeTurn / cancel&lt;br&gt;规范化 Runtime Event" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;strokeColor=#00897B;fillColor=#D9F3F0;fontFamily=PingFang SC;fontSize=13;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="1370" y="90" width="205" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p1-permission" value="&lt;b&gt;权限系统&lt;/b&gt;&lt;br&gt;Policy Engine&lt;br&gt;Capability Grant&lt;br&gt;Allow / Ask / Deny&lt;br&gt;一次性 ExecutionPermit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;strokeColor=#D6A800;fillColor=#FFF2CC;fontFamily=PingFang SC;fontSize=13;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="1040" y="115" width="255" height="155" as="geometry" />
        </mxCell>
        <mxCell id="p1-multi" value="&lt;b&gt;Multi-agent Manager&lt;/b&gt;&lt;br&gt;ExecutionScope Supervisor&lt;br&gt;Team Supervisor&lt;br&gt;Role Assignment&lt;br&gt;任务、消息与终止协调&lt;br&gt;&lt;font color=&quot;#6A1B9A&quot;&gt;不包含业务 Workflow&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;strokeColor=#7B1FA2;fillColor=#EEE5FA;fontFamily=PingFang SC;fontSize=13;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="345" y="300" width="270" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p1-runtime" value="&lt;b&gt;Agent Runtime Pool｜执行面&lt;/b&gt;&lt;br&gt;Runtime Worker / RunAttempt&lt;br&gt;Agent Loop / Budget / Deadline&lt;br&gt;模型—工具—上下文循环&lt;br&gt;&lt;font color=&quot;#A64600&quot;&gt;执行 AgentRun，不拥有系统调度&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=3;strokeColor=#C65D1E;fillColor=#FCE8D5;fontFamily=PingFang SC;fontSize=14;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="690" y="300" width="280" height="210" as="geometry" />
        </mxCell>
        <mxCell id="p1-tools" value="&lt;b&gt;可扩展工具系统&lt;/b&gt;&lt;br&gt;Tool Registry / Descriptor&lt;br&gt;Tool Runtime / Schema&lt;br&gt;Provider Registry&lt;br&gt;结果归一化与审计事件&lt;br&gt;&lt;font color=&quot;#1565C0&quot;&gt;只有 Permit 才可执行&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;strokeColor=#1976D2;fillColor=#DCEBFA;fontFamily=PingFang SC;fontSize=13;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="1035" y="330" width="265" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p1-memory" value="&lt;b&gt;长记忆管理&lt;/b&gt;&lt;br&gt;MemorySpace / MemoryGrant&lt;br&gt;Private / ExecutionScope / Team&lt;br&gt;MemoryCandidate → Commit&lt;br&gt;追加、版本、失效与检索&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;共享必须显式授权&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;strokeColor=#388E3C;fillColor=#E2F0D9;fontFamily=PingFang SC;fontSize=13;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="345" y="575" width="290" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p1-context" value="&lt;b&gt;Context Engine&lt;/b&gt;&lt;br&gt;Working Context / Snapshot&lt;br&gt;预算、选择、压缩、解释&lt;br&gt;只读取授权 Memory View" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;strokeColor=#00897B;fillColor=#D9F3F0;fontFamily=PingFang SC;fontSize=13;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="690" y="590" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p1-journal" value="&lt;b&gt;运行状态与事件&lt;/b&gt;&lt;br&gt;Run / Scope / Team Journal&lt;br&gt;状态重建与事件发布" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;strokeColor=#607D8B;fillColor=#ECEFF3;fontFamily=PingFang SC;fontSize=13;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="1035" y="600" width="265" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p1-pi" value="&lt;b&gt;Pi / 未来 Runtime Adapter&lt;/b&gt;&lt;br&gt;Pi 原生类型不得越界" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;strokeColor=#00897B;fillColor=#D9F3F0;fontFamily=PingFang SC;fontSize=13;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="1370" y="200" width="205" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1-approval" value="&lt;b&gt;审批交互 / ApprovalPort&lt;/b&gt;&lt;br&gt;展示 Ask，提交人工决定&lt;br&gt;不在 Kernel 内选择审批人" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;strokeColor=#D6A800;fillColor=#FFF8E1;fontFamily=PingFang SC;fontSize=12;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="1370" y="315" width="205" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p1-env" value="&lt;b&gt;Execution Environment&lt;/b&gt;&lt;br&gt;ToolProviderPort / SandboxPort&lt;br&gt;Files / Shell / Web / MCP&lt;br&gt;进程、容器与网络机制" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;strokeColor=#607D8B;fillColor=#ECEFF3;fontFamily=PingFang SC;fontSize=12;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="1370" y="465" width="205" height="125" as="geometry" />
        </mxCell>
        <mxCell id="p1-store" value="&lt;b&gt;Scoped Infrastructure Adapter&lt;/b&gt;&lt;br&gt;RunStore / MemoryStore / ArtifactStore&lt;br&gt;隔离分区由 KernelHost 预绑定" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=2;strokeColor=#607D8B;fillColor=#ECEFF3;fontFamily=PingFang SC;fontSize=12;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="1370" y="650" width="205" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p1-note" value="&lt;b&gt;V3 边界不变量&lt;/b&gt;&lt;br&gt;① 系统是边界，Run 是工作负载，Runtime 是执行服务&lt;br&gt;② Kernel 公共契约中不存在 Tenant / RBAC&lt;br&gt;③ 所有受保护动作经过统一安全入口&lt;br&gt;④ Runtime 不绕过 Tool Runtime 调工具&lt;br&gt;⑤ Agent 不直接写共享记忆；Subagent 不成为孤儿" style="shape=note;whiteSpace=wrap;html=1;size=16;strokeWidth=2;strokeColor=#D32F2F;fillColor=#FFEBEE;fontFamily=PingFang SC;fontSize=12;fontColor=#7F1D1D;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="35" y="520" width="245" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p1-legend" value="&lt;b&gt;线型&lt;/b&gt;　实线＝命令/调用　　虚线＝事件/结果　　红色虚线＝禁止旁路" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#CBD5E1;fillColor=#F8FAFC;fontFamily=PingFang SC;fontSize=12;fontColor=#334155;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="305" y="835" width="1040" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p1-e-host-gateway" value="AgentRunSpec / TeamRunSpec&lt;br&gt;&lt;font color=&quot;#C62828&quot;&gt;不含 TenantContext&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#455A64;endArrow=block;endFill=1;fontFamily=PingFang SC;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1-host" target="p1-gateway"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1-e-gateway-runtime" value="submitRun / query / cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#C65D1E;endArrow=block;endFill=1;fontFamily=PingFang SC;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1-gateway" target="p1-control"><mxGeometry relative="1" y="-18" as="geometry" /></mxCell>
        <mxCell id="p1-e-gateway-multi" value="submitTeam" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#7B1FA2;endArrow=block;endFill=1;fontFamily=PingFang SC;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p1-control" target="p1-multi"><mxGeometry relative="1" as="geometry" /></mxCell>
