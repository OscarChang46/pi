        <mxCell id="p1-e-runtime-tool" value="ToolInvocation / ToolResult" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#1976D2;endArrow=block;endFill=1;startArrow=block;startFill=1;fontFamily=PingFang SC;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1-runtime" target="p1-tools"><mxGeometry relative="1" y="-20" as="geometry" /></mxCell>
