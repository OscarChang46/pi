        <mxCell id="p2-life-tool" value="" style="edgeStyle=none;html=1;dashed=1;dashPattern=4 4;strokeColor=#CBD5E1;endArrow=none;" edge="1" parent="1-2"><mxGeometry relative="1" as="geometry"><mxPoint x="415" y="180" as="sourcePoint" /><mxPoint x="415" y="770" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p2-life-permission" value="" style="edgeStyle=none;html=1;dashed=1;dashPattern=4 4;strokeColor=#CBD5E1;endArrow=none;" edge="1" parent="1-2"><mxGeometry relative="1" as="geometry"><mxPoint x="695" y="180" as="sourcePoint" /><mxPoint x="695" y="770" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p2-life-approval" value="" style="edgeStyle=none;html=1;dashed=1;dashPattern=4 4;strokeColor=#CBD5E1;endArrow=none;" edge="1" parent="1-2"><mxGeometry relative="1" as="geometry"><mxPoint x="970" y="180" as="sourcePoint" /><mxPoint x="970" y="770" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p2-life-provider" value="" style="edgeStyle=none;html=1;dashed=1;dashPattern=4 4;strokeColor=#CBD5E1;endArrow=none;" edge="1" parent="1-2"><mxGeometry relative="1" as="geometry"><mxPoint x="1230" y="180" as="sourcePoint" /><mxPoint x="1230" y="770" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p2-life-sandbox" value="" style="edgeStyle=none;html=1;dashed=1;dashPattern=4 4;strokeColor=#CBD5E1;endArrow=none;" edge="1" parent="1-2"><mxGeometry relative="1" as="geometry"><mxPoint x="1475" y="180" as="sourcePoint" /><mxPoint x="1475" y="770" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p2-e1" value="① ToolInvocation&lt;br&gt;toolId / args / AgentId / RoleId" style="edgeStyle=none;html=1;strokeWidth=2;strokeColor=#1976D2;endArrow=block;endFill=1;fontFamily=PingFang SC;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1-2"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="230" as="sourcePoint" /><mxPoint x="415" y="230" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p2-e2" value="② authorize(ActionProposal)&lt;br&gt;CapabilityGrant + ToolDescriptor" style="edgeStyle=none;html=1;strokeWidth=2;strokeColor=#D6A800;endArrow=block;endFill=1;fontFamily=PingFang SC;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1-2"><mxGeometry relative="1" as="geometry"><mxPoint x="415" y="310" as="sourcePoint" /><mxPoint x="695" y="310" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p2-deny" value="③a Deny：稳定错误码 + 审计事件" style="edgeStyle=none;html=1;dashed=1;dashPattern=7 5;strokeWidth=2;strokeColor=#D32F2F;endArrow=block;endFill=1;fontFamily=PingFang SC;fontSize=11;fontColor=#C62828;labelBackgroundColor=#FFFFFF;" edge="1" parent="1-2"><mxGeometry relative="1" as="geometry"><mxPoint x="695" y="380" as="sourcePoint" /><mxPoint x="415" y="380" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p2-ask" value="③b Ask：ApprovalRequest&lt;br&gt;动作摘要，不泄露 Secret" style="edgeStyle=none;html=1;strokeWidth=2;strokeColor=#D6A800;endArrow=block;endFill=1;fontFamily=PingFang SC;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1-2"><mxGeometry relative="1" as="geometry"><mxPoint x="695" y="445" as="sourcePoint" /><mxPoint x="970" y="445" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p2-decision" value="④ ApprovalDecision" style="edgeStyle=none;html=1;dashed=1;dashPattern=7 5;strokeWidth=2;strokeColor=#D6A800;endArrow=block;endFill=1;fontFamily=PingFang SC;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1-2"><mxGeometry relative="1" as="geometry"><mxPoint x="970" y="505" as="sourcePoint" /><mxPoint x="695" y="505" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p2-permit" value="⑤ Allow：ExecutionPermit&lt;br&gt;绑定 actionHash / agent / deadline / 单次使用" style="edgeStyle=none;html=1;dashed=1;dashPattern=7 5;strokeWidth=2;strokeColor=#2E7D32;endArrow=block;endFill=1;fontFamily=PingFang SC;fontSize=11;fontColor=#1B5E20;labelBackgroundColor=#FFFFFF;" edge="1" parent="1-2"><mxGeometry relative="1" as="geometry"><mxPoint x="695" y="565" as="sourcePoint" /><mxPoint x="415" y="565" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p2-execute" value="⑥ execute(NormalizedToolRequest, Permit)" style="edgeStyle=none;html=1;strokeWidth=2;strokeColor=#1976D2;endArrow=block;endFill=1;fontFamily=PingFang SC;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1-2"><mxGeometry relative="1" as="geometry"><mxPoint x="415" y="625" as="sourcePoint" /><mxPoint x="1230" y="625" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p2-sandbox-call" value="⑦ SandboxProfile + 资源限制" style="edgeStyle=none;html=1;strokeWidth=2;strokeColor=#607D8B;endArrow=block;endFill=1;fontFamily=PingFang SC;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1-2"><mxGeometry relative="1" as="geometry"><mxPoint x="1230" y="680" as="sourcePoint" /><mxPoint x="1475" y="680" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p2-result" value="⑧ ToolResult / ToolEvent（有界、脱敏）" style="edgeStyle=none;html=1;dashed=1;dashPattern=7 5;strokeWidth=2;strokeColor=#1976D2;endArrow=block;endFill=1;fontFamily=PingFang SC;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1-2"><mxGeometry relative="1" as="geometry"><mxPoint x="1475" y="745" as="sourcePoint" /><mxPoint x="150" y="745" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="p2-note" value="&lt;b&gt;评审约束&lt;/b&gt;&lt;br&gt;Permission System 只裁决，不执行工具；ToolProvider 只执行，不决定权限；Sandbox 只提供机制。任何 Provider 均不能接受缺失或不匹配的 ExecutionPermit。" style="shape=note;whiteSpace=wrap;html=1;size=16;strokeWidth=2;strokeColor=#D32F2F;fillColor=#FFEBEE;fontFamily=PingFang SC;fontSize=12;fontColor=#7F1D1D;spacing=8;" vertex="1" parent="1-2"><mxGeometry x="390" y="790" width="820" height="75" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="kernel-v2-multiagent-memory" name="03 生命周期与共享记忆">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0-3" />
        <mxCell id="1-3" parent="0-3" />
        <mxCell id="p3-title" value="&lt;b&gt;Subagent 结构化并发、Multi-agent 角色与共享长记忆&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontFamily=PingFang SC;fontSize=20;fontColor=#172033;" vertex="1" parent="1-3"><mxGeometry x="40" y="25" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="p3-sub-boundary" value="&lt;b&gt;Subagent：生命周期所有权树&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;strokeColor=#7B1FA2;fillColor=#FBF7FE;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;fontFamily=PingFang SC;fontSize=15;fontColor=#6A1B9A;" vertex="1" parent="1-3"><mxGeometry x="35" y="85" width="740" height="385" as="geometry" /></mxCell>
        <mxCell id="p3-parent" value="&lt;b&gt;Parent AgentRun&lt;/b&gt;&lt;br&gt;RUNNING → DRAINING → 终态&lt;br&gt;终态前必须 Join/Cancel Child" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#C65D1E;fillColor=#FCE8D5;fontFamily=PingFang SC;fontSize=13;" vertex="1" parent="1-3"><mxGeometry x="75" y="160" width="220" height="105" as="geometry" /></mxCell>
        <mxCell id="p3-scope" value="&lt;b&gt;AgentExecutionScope 聚合&lt;/b&gt;&lt;br&gt;Child Registry / JoinPolicy&lt;br&gt;FailurePolicy / BudgetGrant&lt;br&gt;级联取消 / 无孤儿约束&lt;br&gt;Supervisor Lease + Heartbeat" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=3;strokeColor=#7B1FA2;fillColor=#EEE5FA;fontFamily=PingFang SC;fontSize=13;" vertex="1" parent="1-3"><mxGeometry x="345" y="145" width="245" height="155" as="geometry" /></mxCell>
        <mxCell id="p3-child-a" value="&lt;b&gt;Child AgentRun A&lt;/b&gt;&lt;br&gt;独立 Context / Budget&lt;br&gt;权限为 Parent 子集" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#C65D1E;fillColor=#FFF3E0;fontFamily=PingFang SC;fontSize=12;" vertex="1" parent="1-3"><mxGeometry x="625" y="130" width="120" height="115" as="geometry" /></mxCell>
        <mxCell id="p3-child-b" value="&lt;b&gt;Child AgentRun B&lt;/b&gt;&lt;br&gt;独立 Context / Budget&lt;br&gt;权限为 Parent 子集" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#C65D1E;fillColor=#FFF3E0;fontFamily=PingFang SC;fontSize=12;" vertex="1" parent="1-3"><mxGeometry x="625" y="285" width="120" height="115" as="geometry" /></mxCell>
        <mxCell id="p3-sub-note" value="&lt;b&gt;崩溃与重试&lt;/b&gt;&lt;br&gt;进程崩溃不等于逻辑 Parent 终止；Supervisor 重建 Scope 后重新挂接活动 Child。只读/幂等动作可受控重试；未知副作用进入 BLOCKED，不自动重放。" style="shape=note;whiteSpace=wrap;html=1;size=16;strokeColor=#A16207;fillColor=#FFFBEB;fontFamily=PingFang SC;fontSize=11;fontColor=#78350F;spacing=8;" vertex="1" parent="1-3"><mxGeometry x="75" y="330" width="500" height="105" as="geometry" /></mxCell>
        <mxCell id="p3-e-parent-scope" value="spawn / cancel / join" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#7B1FA2;endArrow=block;endFill=1;fontFamily=PingFang SC;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1-3" source="p3-parent" target="p3-scope"><mxGeometry relative="1" y="-15" as="geometry" /></mxCell>
        <mxCell id="p3-e-scope-a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#7B1FA2;endArrow=block;endFill=1;" edge="1" parent="1-3" source="p3-scope" target="p3-child-a"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3-e-scope-b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#7B1FA2;endArrow=block;endFill=1;" edge="1" parent="1-3" source="p3-scope" target="p3-child-b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3-e-a-scope" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=7 5;strokeWidth=2;strokeColor=#7B1FA2;endArrow=block;endFill=1;" edge="1" parent="1-3" source="p3-child-a" target="p3-scope"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3-e-b-scope" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=7 5;strokeWidth=2;strokeColor=#7B1FA2;endArrow=block;endFill=1;" edge="1" parent="1-3" source="p3-child-b" target="p3-scope"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3-team-boundary" value="&lt;b&gt;Multi-agent：带角色的协作关系图&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;strokeColor=#1565C0;fillColor=#F5FAFF;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;fontFamily=PingFang SC;fontSize=15;fontColor=#0D47A1;" vertex="1" parent="1-3"><mxGeometry x="815" y="85" width="750" height="385" as="geometry" /></mxCell>
        <mxCell id="p3-team" value="&lt;b&gt;MultiAgentRun 聚合&lt;/b&gt;&lt;br&gt;Team Supervisor&lt;br&gt;Participant Registry&lt;br&gt;Role Assignment&lt;br&gt;Coordination / Termination Policy" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=3;strokeColor=#1565C0;fillColor=#DCEBFA;fontFamily=PingFang SC;fontSize=13;" vertex="1" parent="1-3"><mxGeometry x="850" y="145" width="235" height="155" as="geometry" /></mxCell>
        <mxCell id="p3-coordinator" value="&lt;b&gt;Coordinator&lt;/b&gt;&lt;br&gt;拆解 / 分派 / 聚合&lt;br&gt;可协调，不自动获得高风险工具" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#7B1FA2;fillColor=#EEE5FA;fontFamily=PingFang SC;fontSize=12;" vertex="1" parent="1-3"><mxGeometry x="1130" y="130" width="180" height="110" as="geometry" /></mxCell>
        <mxCell id="p3-worker" value="&lt;b&gt;Worker&lt;/b&gt;&lt;br&gt;执行受限 Assignment&lt;br&gt;默认不可再委派" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#C65D1E;fillColor=#FFF3E0;fontFamily=PingFang SC;fontSize=12;" vertex="1" parent="1-3"><mxGeometry x="1345" y="130" width="180" height="110" as="geometry" /></mxCell>
        <mxCell id="p3-reviewer" value="&lt;b&gt;Reviewer&lt;/b&gt;&lt;br&gt;只读复核 / 结构化意见&lt;br&gt;不直接修改 Worker 结果" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#388E3C;fillColor=#E2F0D9;fontFamily=PingFang SC;fontSize=12;" vertex="1" parent="1-3"><mxGeometry x="1130" y="290" width="180" height="110" as="geometry" /></mxCell>
        <mxCell id="p3-role" value="&lt;b&gt;AgentRoleDescriptor&lt;/b&gt;&lt;br&gt;objective / capabilities / tools&lt;br&gt;contextView / memoryGrant&lt;br&gt;communication / outputContract / budget" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#D6A800;fillColor=#FFF8E1;fontFamily=PingFang SC;fontSize=11;" vertex="1" parent="1-3"><mxGeometry x="1345" y="285" width="180" height="120" as="geometry" /></mxCell>
        <mxCell id="p3-e-team-coord" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#1565C0;endArrow=block;endFill=1;" edge="1" parent="1-3" source="p3-team" target="p3-coordinator"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3-e-team-worker" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#1565C0;endArrow=block;endFill=1;" edge="1" parent="1-3" source="p3-team" target="p3-worker"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3-e-team-review" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#1565C0;endArrow=block;endFill=1;" edge="1" parent="1-3" source="p3-team" target="p3-reviewer"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3-e-role-team" value="角色契约" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=7 5;strokeWidth=2;strokeColor=#D6A800;endArrow=block;endFill=1;fontFamily=PingFang SC;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1-3" source="p3-role" target="p3-team"><mxGeometry relative="1" y="15" as="geometry" /></mxCell>
        <mxCell id="p3-memory-boundary" value="&lt;b&gt;长记忆访问模型：共享的是 MemorySpace，不是可变 Agent Context&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;strokeColor=#388E3C;fillColor=#F7FCF5;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;fontFamily=PingFang SC;fontSize=15;fontColor=#1B5E20;" vertex="1" parent="1-3"><mxGeometry x="35" y="500" width="1530" height="330" as="geometry" /></mxCell>
        <mxCell id="p3-private" value="&lt;b&gt;Private MemorySpace&lt;/b&gt;&lt;br&gt;单 Agent 可见&lt;br&gt;跨 Agent 默认拒绝" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#388E3C;fillColor=#E2F0D9;fontFamily=PingFang SC;fontSize=12;" vertex="1" parent="1-3"><mxGeometry x="80" y="590" width="200" height="105" as="geometry" /></mxCell>
        <mxCell id="p3-scope-memory" value="&lt;b&gt;ExecutionScope Memory&lt;/b&gt;&lt;br&gt;Parent 与授权 Child 可见&lt;br&gt;Scope 终止后按策略归档" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#388E3C;fillColor=#E2F0D9;fontFamily=PingFang SC;fontSize=12;" vertex="1" parent="1-3"><mxGeometry x="330" y="590" width="220" height="105" as="geometry" /></mxCell>
        <mxCell id="p3-team-memory" value="&lt;b&gt;Team MemorySpace&lt;/b&gt;&lt;br&gt;按 Role / Participant 授权&lt;br&gt;读、追加、提议写入分离" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#388E3C;fillColor=#E2F0D9;fontFamily=PingFang SC;fontSize=12;" vertex="1" parent="1-3"><mxGeometry x="600" y="590" width="220" height="105" as="geometry" /></mxCell>
        <mxCell id="p3-memory-manager" value="&lt;b&gt;Long Memory Manager&lt;/b&gt;&lt;br&gt;MemoryGrant 校验&lt;br&gt;Candidate 验证 / 去重 / 版本化&lt;br&gt;提交、失效、检索与审计事件" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=3;strokeColor=#2E7D32;fillColor=#C8E6C9;fontFamily=PingFang SC;fontSize=13;" vertex="1" parent="1-3"><mxGeometry x="885" y="570" width="260" height="145" as="geometry" /></mxCell>
        <mxCell id="p3-store" value="&lt;b&gt;MemoryStorePort&lt;/b&gt;&lt;br&gt;Append-only Entry&lt;br&gt;supersedes / version / provenance&lt;br&gt;实际隔离分区由 Host 预绑定" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#607D8B;fillColor=#ECEFF3;fontFamily=PingFang SC;fontSize=12;" vertex="1" parent="1-3"><mxGeometry x="1210" y="570" width="275" height="145" as="geometry" /></mxCell>
        <mxCell id="p3-memory-note" value="Turn 开始时读取版本化 MemoryView；Agent 只能提交 MemoryCandidate，不能直接覆盖共享记忆。冲突通过追加新版本与 supersedes 关系解决，避免多个 Agent 并发修改同一 Context。" style="shape=note;whiteSpace=wrap;html=1;size=16;strokeColor=#388E3C;fillColor=#F1F8E9;fontFamily=PingFang SC;fontSize=11;fontColor=#1B5E20;spacing=8;" vertex="1" parent="1-3"><mxGeometry x="330" y="740" width="815" height="65" as="geometry" /></mxCell>
        <mxCell id="p3-e-private-manager" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#388E3C;endArrow=block;endFill=1;" edge="1" parent="1-3" source="p3-private" target="p3-memory-manager"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3-e-scope-manager" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#388E3C;endArrow=block;endFill=1;" edge="1" parent="1-3" source="p3-scope-memory" target="p3-memory-manager"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3-e-team-manager" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#388E3C;endArrow=block;endFill=1;" edge="1" parent="1-3" source="p3-team-memory" target="p3-memory-manager"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3-e-manager-store" value="MemoryStorePort" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#607D8B;endArrow=block;endFill=1;fontFamily=PingFang SC;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1-3" source="p3-memory-manager" target="p3-store"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
