        <mxCell id="p2-approval" value="&lt;b&gt;ApprovalPort&lt;/b&gt;&lt;br&gt;人工 Ask/Decision" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#D6A800;fillColor=#FFF8E1;fontFamily=PingFang SC;fontSize=13;" vertex="1" parent="1-2"><mxGeometry x="870" y="100" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="p2-provider" value="&lt;b&gt;ToolProvider&lt;/b&gt;&lt;br&gt;可扩展 Adapter" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#1976D2;fillColor=#E3F2FD;fontFamily=PingFang SC;fontSize=13;" vertex="1" parent="1-2"><mxGeometry x="1135" y="100" width="190" height="80" as="geometry" /></mxCell>
