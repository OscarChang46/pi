        <mxCell id="p3-e-team-manager" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#388E3C;endArrow=block;endFill=1;" edge="1" parent="1-3" source="p3-team-memory" target="p3-memory-manager">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e-manager-store" value="MemoryStorePort" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#607D8B;endArrow=block;endFill=1;fontFamily=PingFang SC;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1-3" source="p3-memory-manager" target="p3-store">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
